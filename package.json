{
  "name": "@blockrun/router-core",
  "version": "0.1.0",
  "description": "Smart LLM router — deterministic, constraint-first automatic model selection shared by BlockRun products.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check",
    "probe:profiles": "node scripts/probe-model-profiles.mjs",
    "sync:capabilities": "node scripts/sync-model-capabilities.mjs"
  },
  "keywords": [
    "llm",
    "router",
    "llm-router",
    "smart-router",
    "smart-llm-router",
    "ai-model-router",
    "model-routing",
    "model-selection",
    "automatic-model-selection",
    "routing-engine",
    "llm-cost-optimization",
    "blockrun"
  ],
  "author": "BlockRun <hello@blockrun.ai>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlockRunAI/router-core.git"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.3"
  }
}
